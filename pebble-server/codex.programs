            __u32 key_hash = 2166136261u;
            bool key_ok = false;

            #pragma clang loop unroll(full)
            for (int i = 0; i < 32; i++) {
                if ((void *)(cur + 1) > end)
                    break;
                char c = *cur;
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r')
                    break;
                key_ok = true;
                key_hash ^= (__u32)c;
                key_hash *= 16777619u;
                cur++;
            }

            #pragma clang loop unroll(full)
            for (int i = 0; i < 8; i++) {
                if ((void *)(cur + 1) > end)
