SEC("sk_reuseport/selector")
enum sk_action agent_udp_selector(struct sk_reuseport_md *reuse)
{
    __u32 active = get_active_workers();

    __u32 hash = reuse->hash;
    if (hash == 0)
        hash = bpf_get_prandom_u32();

    if (is_scan_request(reuse))
        hash ^= 0x9e3779b9;

    __u64 now = bpf_ktime_get_ns();
    hash ^= (__u32)(now >> 17);
    hash = mix_hash(hash);

    if (active > 0) {
        __u32 search = active;
        if (search > 32)
            search = 32;

        __u32 start = hash % active;
        __u32 step = ((hash >> 16) % active) | 1;
        if (step >= active)
            step = 1;

        __u32 slot = start;

        #pragma clang loop unroll(full)
        for (int i = 0; i < 32; i++) {
            if (i >= search)
                break;

            if (slot >= active)
                slot -= active;

            __u32 candidate = slot;
            if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &candidate, 0) == 0)
                return SK_PASS;

            slot += step;
            if (slot >= active)
                slot -= active;
        }
    }

    __u32 fallback = 0;
    if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &fallback, 0) == 0)
        return SK_PASS;
    return SK_PASS;
}

