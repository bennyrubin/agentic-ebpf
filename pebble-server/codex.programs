            for (int i = 0; i < 6; i++) {
                if ((void *)(cur + 1) > end)
                    break;
                char c = *cur;
                if (c < '0' || c > '9')
                    break;
                limit_ok = true;
                limit = limit * 10 + (__u32)(c - '0');
                cur++;
            }

            if (limit_ok && limit >= HEAVY_SCAN_THRESHOLD)
                heavy_scan = true;
            else if (!limit_ok)
                heavy_scan = true;

            if (key_ok)
                keyed_hash = mix_hash(hash ^ key_hash ^ 0x9e3779b9);
            else
                keyed_hash = mix_hash(hash ^ 0x9e3779b9);
        } else if (payload[0] == 'G' && payload[1] == 'E' && payload[2] == 'T') {
            char *cur = payload + 3;

            #pragma clang loop unroll(full)
            for (int i = 0; i < 8; i++) {
                if ((void *)(cur + 1) > end)
                    break;
                if (*cur != ' ')
                    break;
                cur++;
            }

            __u32 key_hash = 2166136261u;
            bool key_ok = false;

            #pragma clang loop unroll(full)
            for (int i = 0; i < 32; i++) {
                if ((void *)(cur + 1) > end)
                    break;
                char c = *cur;
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r')
                    break;
                key_ok = true;
                key_hash ^= (__u32)c;
                key_hash *= 16777619u;
                cur++;
            }

            if (key_ok)
                keyed_hash = mix_hash(hash ^ key_hash);
        }
    }

    __u32 slot;

    if (heavy_scan && active > 1) {
        __u32 heavy_slots = active / 3;
        if (heavy_slots == 0)
            heavy_slots = 1;
        if (heavy_slots > MAX_HEAVY_SLOTS)
            heavy_slots = MAX_HEAVY_SLOTS;
        if (heavy_slots >= active)
            heavy_slots = active - 1;

        __u32 base = active - heavy_slots;
        slot = base + (keyed_hash % heavy_slots);
    } else {
        slot = keyed_hash % active;
    }

    __u32 candidate = slot;
    if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &candidate, 0) == 0)
        return SK_PASS;

    __u32 fallback = keyed_hash % active;
    if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &fallback, 0) == 0)
