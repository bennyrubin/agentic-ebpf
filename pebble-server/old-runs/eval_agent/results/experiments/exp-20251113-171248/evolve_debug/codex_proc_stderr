 __u32 slot1 = ((__u64)(h ^ 0x9e3779b9u) * (__u64)active) >> 32;\n    if (slot1 != slot0) {\n        if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &slot1, 0) == 0)\n            return SK_PASS;\n    }\n\n    __u32 slot2 = ((__u64)(h + 0x7f4a7c15u) * (__u64)active) >> 32;\n    if (slot2 != slot0 && slot2 != slot1) {\n        if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &slot2, 0) == 0)\n            return SK_PASS;\n    }\n\n    __u32 slot3 = ((__u64)(h ^ 0xd2511f53u) * (__u64)active) >> 32;\n    if (slot3 != slot0 && slot3 != slot1 && slot3 != slot2) {\n        if (bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &slot3, 0) == 0)\n            return SK_PASS;\n    }\n\n    // Fall back to kernel policy if all candidates are rejected.\n    return SK_PASS;\n}\n// EVOLVE-BLOCK-END\n\nchar _license[] SEC(\"license\") = \"GPL\";\n", "language": "cpp", "parent_id": "4f939d7d-9185-4069-9da0-75c8f987f576", "generation": 2, "timestamp": 1763046835.0688608, "iteration_found": 2, "metrics": {"policy": "agent", "rates": [50000, 60000, 80000, 100000, 140000], "load_p99_curve": [[50000.0, 509.069], [60000.0, 15.641], [80000.0, 2702.542], [100000.0, 646.688], [140000.0, 6605.115]], "load_p99_stddev_curve": [[50000.0, 0.0], [60000.0, 0.0], [80000.0, 0.0], [100000.0, 0.0], [140000.0, 0.0]], "compile": 1.0, "load": 1.0, "combined_score": -20833.374, "run_success": 1.0}, "complexity": 0.0, "diversity": 0.0, "metadata": {"changes": "Change 1: Replace 31 lines with 50 lines", "parent_metrics": {"policy": "agent", "rates": [50000, 60000, 80000, 100000, 140000], "load_p99_curve": [[50000.0, 5.839], [60000.0, 23.415], [80000.0, 10.745], [100000.0, 4465.972], [140000.0, 3864.677]], "load_p99_stddev_curve": [[50000.0, 0.0], [60000.0, 0.0], [80000.0, 0.0], [100000.0, 0.0], [140000.0, 0.0]], "compile": 1.0, "load": 1.0, "combined_score": -21186.802, "run_success": 1.0}, "island": 0}, "prompts": null, "artifacts_json": "{\"summary\": \"{\\n  \\\"metadata\\\": {\\n    \\\"ex